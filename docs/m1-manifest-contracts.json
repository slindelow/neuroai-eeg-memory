            {
              "stage_index": 3,
              "stage": "eligible_subject_trials",
              "reason_code_order": [
                "TOO_FEW_SESSIONS", "SINGLE_CLASS_OUTER_TRAIN", "SINGLE_CLASS_OUTER_TEST",
                "SINGLE_CLASS_INNER_FOLD"
              ]
            }
          ]
        },
        "subject_condition_eligibility": {
          "count_unit": "subject_condition",
          "stages": [
            {
              "stage_index": 0,
              "stage": "candidate_subject_conditions",
              "reason_code_order": []
            },
            {
              "stage_index": 1,
              "stage": "technical_session_eligibility",
              "reason_code_order": [
                "MISSING_DERIVATIVE", "UNREADABLE_METADATA", "CHANNEL_SCHEMA_MISMATCH",
                "NONFINITE_INPUT", "TRIAL_EPOCH_KEY_MISMATCH"
              ]
            },
            {
              "stage_index": 2,
              "stage": "minimum_complete_sessions",
              "reason_code_order": ["TOO_FEW_SESSIONS"]
            },
            {
              "stage_index": 3,
              "stage": "outer_partition_class_feasibility",
              "reason_code_order": ["SINGLE_CLASS_OUTER_TRAIN", "SINGLE_CLASS_OUTER_TEST"]
            },
            {
              "stage_index": 4,
              "stage": "inner_fold_class_feasibility",
              "reason_code_order": ["SINGLE_CLASS_INNER_FOLD"]
            }
          ]
        },
        "cross_condition_sensitivity": {
          "count_unit": "trial",
          "input_binding": {"flow_id": "trial_analysis", "stage_index": 3},
          "stages": [
            {
              "stage_index": 0,
              "stage": "cross_condition_intersection",
              "reason_code_order": ["ABSENT_FROM_OTHER_CONDITION"]
            }
          ]
        }
      }
